# ============================================================
# PARKING ID
# ============================================================

def generate_parking_id():
    return datetime.now().strftime("PS-%Y%m%d-%H%M%S")

# ============================================================
# DASHBOARD STATISTICS
# ============================================================

def update_dashboard_stats():

    available = sum(
        s["status"] == "available"
        for s in parking_slots
    )

    occupied = sum(
        s["status"] == "occupied"
        for s in parking_slots
    )

    if available_count_label:
        available_count_label.config(
            text=str(available)
        )

    if occupied_count_label:
        occupied_count_label.config(
            text=str(occupied)
        )

# ============================================================
# BILL CALCULATION
# ============================================================

def calculate_bill(entry_time, exit_time, rate):

    duration = exit_time - entry_time

    total_seconds = duration.total_seconds()

    hours = max(
        1,
        math.ceil(total_seconds / 3600)
    )

    return hours, hours * rate

