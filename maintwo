# EXIT PARKING
# ============================================================

def exit_parking():

    global current_parking

    if current_parking is None:

        messagebox.showinfo(
            "Exit Parking",
            "You do not have an active parking session."
        )

        return

    parking = current_parking

    confirm = messagebox.askyesno(
        "Confirm Exit",
        f"Exit parking for slot {parking['slot']}?\n\n"
        f"Parking ID: {parking['parking_id']}"
    )

    if not confirm:
        return

    exit_time = datetime.now()

    hours, total_amount = calculate_bill(
        parking["entry_time"],
        exit_time,
        parking["rate"]
    )

    for slot in parking_slots:

        if slot["slot"] == parking["slot"]:

            slot["status"] = "available"

            break

    bill_window = tk.Toplevel(root)

    bill_window.title(
        "ParkSense - Final Bill"
    )

    bill_window.geometry(
        "500x520"
    )

    bill_window.resizable(
        False,
        False
    )

    bill_window.configure(
        bg="#F5F7FA"
    )

    tk.Label(
        bill_window,
        text="PARKSENSE",
        font=("Arial", 24, "bold"),
        fg="white",
        bg="#17202A"
    ).pack(
        fill="x",
        ipady=14
    )

    tk.Label(
        bill_window,
        text="PARKING BILL",
        font=("Arial", 20, "bold"),
        fg="#17202A",
        bg="#F5F7FA"
    ).pack(
        pady=(25, 15)
    )

    bill = (
        f"Parking ID : {parking['parking_id']}\n"
        f"Location   : {parking['location']}\n"
        f"Floor      : {parking['floor']}\n"
        f"Sector     : {parking['sector']}\n"
        f"Lane       : {parking['lane']}\n"
        f"Slot       : {parking['slot']}\n\n"
        f"Entry Time : "
        f"{parking['entry_time'].strftime('%d-%m-%Y %I:%M %p')}\n"
        f"Exit Time  : "
        f"{exit_time.strftime('%d-%m-%Y %I:%M %p')}\n"
        f"Duration   : {hours} hour(s)\n"
        f"Rate       : ₹{parking['rate']}/hour"
    )

    tk.Label(
        bill_window,
        text=bill,
        font=("Arial", 11),
        justify="left",
        fg="#17202A",
        bg="white",
        padx=25,
        pady=20
    ).pack(
        padx=35,
        fill="x"
    )

    tk.Label(
        bill_window,
        text=f"TOTAL BILL  ₹{total_amount}",
        font=("Arial", 19, "bold"),
        fg="#2471A3",
        bg="#F5F7FA"
    ).pack(
        pady=20
    )

    tk.Button(
        bill_window,
        text="Done",
        command=bill_window.destroy,
        font=("Arial", 12, "bold"),
        bg="#2471A3",
        fg="white",
        width=15,
        height=2,
        relief="flat"
    ).pack()

    current_parking = None

    update_dashboard_stats()

