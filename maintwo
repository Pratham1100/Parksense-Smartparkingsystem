    ).pack(
        pady=(25, 5)
    )

    tk.Label(
        parking_window,
        text="Choose a floor and sector to view parking slots.",
        font=("Arial", 11),
        fg="#5D6D7E",
        bg="#F5F7FA"
    ).pack()

    selection_frame = tk.Frame(
        parking_window,
        bg="#F5F7FA"
    )

    selection_frame.pack(
        pady=20
    )

    tk.Label(
        selection_frame,
        text="Floor:",
        font=("Arial", 12, "bold"),
        fg="#17202A",
        bg="#F5F7FA"
    ).grid(
        row=0,
        column=0,
        padx=8
    )

    floor_var = tk.StringVar(
        value="1"
    )

    floor_menu = ttk.Combobox(
        selection_frame,
        textvariable=floor_var,
        values=["1", "2"],
        state="readonly",
        width=12,
        font=("Arial", 11)
    )

    floor_menu.grid(
        row=0,
        column=1,
        padx=8,
        ipady=5
    )

    tk.Label(
        selection_frame,
        text="Sector:",
        font=("Arial", 12, "bold"),
        fg="#17202A",
        bg="#F5F7FA"
    ).grid(
        row=0,
        column=2,
        padx=8
    )

    sector_var = tk.StringVar(
        value="A"
    )

    sector_menu = ttk.Combobox(
        selection_frame,
        textvariable=sector_var,
        values=["A", "B"],
        state="readonly",
        width=12,
        font=("Arial", 11)
    )

    sector_menu.grid(
        row=0,
        column=3,
        padx=8,
        ipady=5
    )

    slots_frame = tk.Frame(
        parking_window,
        bg="#F5F7FA"
    )

    slots_frame.pack(
        pady=5
    )

    available_label = tk.Label(
        parking_window,
        text="",
        font=("Arial", 12, "bold"),
        fg="#27AE60",
        bg="#F5F7FA"
    )

    available_label.pack(
        pady=5
    )

    def occupied_warning(slot):

        messagebox.showwarning(
            "Slot Occupied",
            f"{slot['slot']} is already occupied."
        )

    def book_slot(slot):

        global current_parking

        if current_parking is not None:

            messagebox.showwarning(
                "Active Parking",
                f"You already have an active parking session "
                f"at slot {current_parking['slot']}."
            )

            return

        if slot["status"] == "occupied":

            occupied_warning(slot)

            return

        confirm = messagebox.askyesno(
            "Confirm Parking",

            f"Book this slot?\n\n"
            f"Location: {selected_location}\n"
            f"Floor: {slot['floor']}\n"
            f"Sector: {slot['sector']}\n"
            f"Lane: {slot['lane']}\n"
            f"Slot: {slot['slot']}\n\n"
            f"Parking Rate: ₹40/hour"
        )

        if not confirm:
            return

        slot["status"] = "occupied"

        entry_time = datetime.now()

        parking_id = generate_parking_id()

        current_parking = {
            "parking_id": parking_id,
            "location": selected_location,
            "slot": slot["slot"],
            "floor": slot["floor"],
            "sector": slot["sector"],
            "lane": slot["lane"],
            "entry_time": entry_time,
            "rate": 40
        }

        messagebox.showinfo(
            "Parking Booked",

            f"Parking successfully booked!\n\n"
            f"Parking ID: {parking_id}\n\n"
            f"Location: {selected_location}\n"
            f"Floor: {slot['floor']}\n"
            f"Sector: {slot['sector']}\n"
            f"Lane: {slot['lane']}\n"
            f"Slot: {slot['slot']}\n\n"
            f"Entry Time: "
            f"{entry_time.strftime('%I:%M %p')}\n\n"
            f"Rate: ₹40/hour"
        )

        display_slots()

        update_dashboard_stats()

        show_qr_ticket()

    def display_slots():

        for widget in slots_frame.winfo_children():

            widget.destroy()

        selected_floor = int(
            floor_var.get()
        )

        selected_sector = sector_var.get()

        filtered_slots = [

            slot

            for slot in parking_slots

            if slot["floor"] == selected_floor
            and slot["sector"] == selected_sector
        ]

        available_count = sum(
            slot["status"] == "available"
            for slot in filtered_slots
        )

        available_label.config(
            text=
            f"Available: "
            f"{available_count} / "
            f"{len(filtered_slots)}"
        )

        for index, slot in enumerate(filtered_slots):

            if slot["status"] == "available":

                bg_color = "#27AE60"

                status_text = "AVAILABLE"

                action = book_slot

            else:

                bg_color = "#E74C3C"

                status_text = "OCCUPIED"

                action = occupied_warning

            slot_box = tk.Frame(
                slots_frame,
                bg=bg_color,
                width=160,
                height=90,
                cursor="hand2"
            )

            slot_box.grid(
                row=index // 3,
                column=index % 3,
                padx=12,
                pady=10
            )

            slot_box.pack_propagate(
                False
            )

            slot_label = tk.Label(
                slot_box,
                text=slot["slot"],
                font=("Arial", 15, "bold"),
                fg="white",
                bg=bg_color,
                cursor="hand2"
            )

            slot_label.pack(
                pady=(15, 2)
            )

            status_label = tk.Label(
                slot_box,
                text=status_text,
                font=("Arial", 9, "bold"),
                fg="white",
                bg=bg_color,
                cursor="hand2"
            )

            status_label.pack()

            slot_box.bind(
                "<Button-1>",
                lambda event,
                s=slot,
                a=action:
                a(s)
            )

            slot_label.bind(
                "<Button-1>",
                lambda event,
                s=slot,
                a=action:
                a(s)
            )

            status_label.bind(
                "<Button-1>",
                lambda event,
                s=slot,
                a=action:
                a(s)
            )

    def recommend_slot():

        selected_floor = int(
            floor_var.get()
        )

        selected_sector = sector_var.get()

        available_slots = [

            slot

            for slot in parking_slots

            if slot["floor"] == selected_floor
            and slot["sector"] == selected_sector
            and slot["status"] == "available"
        ]

        if not available_slots:

            messagebox.showwarning(
                "No Parking",
                "No available slots in this floor and sector."
            )

            return

        best_slot = available_slots[0]

        messagebox.showinfo(
            "Recommended Parking",

            f"⭐ Recommended Slot\n\n"
            f"Location: {selected_location}\n"
            f"Floor: {best_slot['floor']}\n"
            f"Sector: {best_slot['sector']}\n"
            f"Lane: {best_slot['lane']}\n"
            f"Slot: {best_slot['slot']}"
        )

    floor_menu.bind(
        "<<ComboboxSelected>>",
        lambda event:
        display_slots()
    )

    sector_menu.bind(
        "<<ComboboxSelected>>",
        lambda event:
        display_slots()
    )

    button_frame = tk.Frame(
        parking_window,
        bg="#F5F7FA"
    )

    button_frame.pack(
        pady=12
    )

    tk.Button(
        button_frame,
        text="View Parking",
        command=display_slots,
        font=("Arial", 12, "bold"),
        bg="#2471A3",
        fg="white",
        width=16,
        height=2,
        relief="flat",
        cursor="hand2"
    ).pack(
        side="left",
        padx=8
    )

    tk.Button(
        button_frame,
        text="Recommend Best Slot",
        command=recommend_slot,
        font=("Arial", 12, "bold"),
        bg="#17202A",
        fg="white",
        width=20,
        height=2,
        relief="flat",
        cursor="hand2"
    ).pack(
        side="left",
        padx=8
    )

    display_slots()

