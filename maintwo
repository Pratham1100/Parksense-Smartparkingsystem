# ============================================================

def show_qr_ticket():

    if current_parking is None:

        messagebox.showinfo(
            "No Ticket",
            "You do not have an active parking ticket."
        )

        return

    parking = current_parking

    qr_data = (
        f"ParkSense Parking Ticket\n"
        f"Parking ID: {parking['parking_id']}\n"
        f"Location: {parking['location']}\n"
        f"Floor: {parking['floor']}\n"
        f"Sector: {parking['sector']}\n"
        f"Lane: {parking['lane']}\n"
        f"Slot: {parking['slot']}\n"
        f"Entry: {parking['entry_time'].strftime('%d-%m-%Y %I:%M %p')}\n"
        f"Rate: Rs. {parking['rate']}/hour"
    )

    qr = qrcode.QRCode(
        version=1,
        box_size=8,
        border=4
    )

    qr.add_data(qr_data)

    qr.make(
        fit=True
    )

    image = qr.make_image(
        fill_color="black",
        back_color="white"
    )

    image = image.resize(
        (220, 220)
    )

    photo = ImageTk.PhotoImage(
        image
    )

    ticket_window = tk.Toplevel(root)

    ticket_window.title(
        "ParkSense - Digital Parking Ticket"
    )

    ticket_window.geometry(
        "520x690"
    )

    ticket_window.resizable(
        False,
        False
    )

    ticket_window.configure(
        bg="#F5F7FA"
    )

    tk.Label(
        ticket_window,
        text="PARKSENSE",
        font=("Arial", 25, "bold"),
        fg="white",
        bg="#17202A"
    ).pack(
        fill="x",
        ipady=15
    )

    tk.Label(
        ticket_window,
        text="DIGITAL PARKING TICKET",
        font=("Arial", 15, "bold"),
        fg="#17202A",
        bg="#F5F7FA"
    ).pack(
        pady=12
    )

    tk.Label(
        ticket_window,
        text=f"Parking ID: {parking['parking_id']}",
        font=("Arial", 12, "bold"),
        fg="#2471A3",
        bg="#F5F7FA"
    ).pack(
        pady=4
    )

    details = (
        f"Location : {parking['location']}\n"
        f"Floor    : {parking['floor']}\n"
        f"Sector   : {parking['sector']}\n"
        f"Lane     : {parking['lane']}\n"
        f"Slot     : {parking['slot']}\n\n"
        f"Entry    : "
        f"{parking['entry_time'].strftime('%d-%m-%Y %I:%M %p')}\n"
        f"Rate     : ₹{parking['rate']}/hour"
    )

    tk.Label(
        ticket_window,
        text=details,
        font=("Arial", 11),
        justify="left",
        fg="#17202A",
        bg="#F5F7FA"
    ).pack(
        pady=8
    )

    tk.Label(
        ticket_window,
        image=photo,
        bg="white"
    ).pack(
        pady=8
    )

    ticket_window.qr_photo = photo

    tk.Label(
        ticket_window,
        text="Scan QR to verify parking details",
        font=("Arial", 10, "bold"),
        fg="#5D6D7E",
        bg="#F5F7FA"
    ).pack(
        pady=4
